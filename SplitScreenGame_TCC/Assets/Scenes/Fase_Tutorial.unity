MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 869791033}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8d41c73c0e1ad8a4bbace0f74ec82a51, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  arrowPointer: {fileID: 709140986}
  player1: {fileID: 665508258}
  player2: {fileID: 1642486118}
  steps:
  - stepType: 0
    instruction: Para construir a BATERIA DESCARREGADA, primeiro pega um PARAFUSO
      na CAIXA DE PARAFUSOS.
    highlightTarget: {fileID: 960284390115249312}
    image: {fileID: 21300000, guid: 5783679b17960914d9e898ed97d952c8, type: 3}
  - stepType: 5
    instruction: Manda para mim o parafuso usando a MESA DE TELETRANSPORTE do seu
      mundo.
    highlightTarget: {fileID: 570395347}
    image: {fileID: 21300000, guid: 5783679b17960914d9e898ed97d952c8, type: 3}
  - stepType: 4
    instruction: Mandei ae!! Pega ela na sua MESA DE TELETRANSPORTE,
    highlightTarget: {fileID: 357053973}
    image: {fileID: 21300000, guid: 88926e71fa79239489e9bfb7a2d36af3, type: 3}
  - stepType: 1
    instruction: Agora vou utilizar da minha MESA DE REPARO para criar a BATERIA
      DESCARREGADA.
    highlightTarget: {fileID: 5861285230547151701}
    image: {fileID: 21300000, guid: 5783679b17960914d9e898ed97d952c8, type: 3}
  - stepType: 5
    instruction: "Agora vou mandar de VOLTA a BATERIA DESCARREGADA para voc\xEA carrega-l\xE1."
    highlightTarget: {fileID: 357053973}
    image: {fileID: 21300000, guid: 5783679b17960914d9e898ed97d952c8, type: 3}
  - stepType: 4
    instruction: "Peguei ela aqui!! Vou levar ela at\xE9 meu CARREGADOR DE BATERIA!!"
    highlightTarget: {fileID: 570395347}
    image: {fileID: 21300000, guid: 88926e71fa79239489e9bfb7a2d36af3, type: 3}
  - stepType: 2
    instruction: Colocando a BATERIA DESCARREGADA para carregar no meu CARREGADOR
      DE BATERIA!!
    highlightTarget: {fileID: 5614764894695864592}
    image: {fileID: 21300000, guid: 88926e71fa79239489e9bfb7a2d36af3, type: 3}
  - stepType: 4
    instruction: "Pronto!! bateria CARREGADA, agora vou deixar na minha bancada aqui
      ao lado para pegar a BANDEJA MAGN\xC9TICA."
    highlightTarget: {fileID: 1984358413}
    image: {fileID: 21300000, guid: 88926e71fa79239489e9bfb7a2d36af3, type: 3}
  - stepType: 6
    instruction: "Pegando BANDEJA MAGN\xC9TICA aqui..."
    highlightTarget: {fileID: 1141527350307869024}
    image: {fileID: 21300000, guid: 88926e71fa79239489e9bfb7a2d36af3, type: 3}
  - stepType: 4
    instruction: "Vou colocar a BATERIA CARREGADA na minha BANDEJA MAGN\xC9TICA."
    highlightTarget: {fileID: 1984358413}
    image: {fileID: 21300000, guid: 88926e71fa79239489e9bfb7a2d36af3, type: 3}
  - stepType: 0
    instruction: "ANTES DE ENTREGAR... Me mande um PNEU que deve ter com voc\xEA."
    highlightTarget: {fileID: 2063029758}
    image: {fileID: 21300000, guid: 88926e71fa79239489e9bfb7a2d36af3, type: 3}
  - stepType: 5
    instruction: "TELETRANSPORTANDO o PNEU para voc\xEA."
    highlightTarget: {fileID: 357053973}
    image: {fileID: 21300000, guid: 5783679b17960914d9e898ed97d952c8, type: 3}
  - stepType: 4
    instruction: "Recebido!! Vou adicionar na minha BANDEJA MAGN\xC9TICA"
    highlightTarget: {fileID: 570395347}
    image: {fileID: 21300000, guid: 88926e71fa79239489e9bfb7a2d36af3, type: 3}
  - stepType: 3
    instruction: "PEDIDO PRONTO!! Agora s\xF3 entregar na BANCADA DE ENTREGA!!"
    highlightTarget: {fileID: 4314568464621229337}
    image: {fileID: 21300000, guid: 88926e71fa79239489e9bfb7a2d36af3, type: 3}
  tutorialTextPlayer1: {fileID: 1596934282}
  tutorialImage: {fileID: 1513852119}
