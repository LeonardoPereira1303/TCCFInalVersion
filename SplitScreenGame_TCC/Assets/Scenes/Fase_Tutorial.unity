--- !u!114 &869791038
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 869791033}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8d41c73c0e1ad8a4bbace0f74ec82a51, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  arrowPointer: {fileID: 709140986}
  player1: {fileID: 665508258}
  player2: {fileID: 1642486118}
  steps:
  - stepType: 0
    instruction: Para fazer a BATERIA, pega aquele PARAFUSO!!
    highlightTarget: {fileID: 960284390115249312}
    image: {fileID: 21300000, guid: 5783679b17960914d9e898ed97d952c8, type: 3}
  - stepType: 5
    instruction: "Me mande o PARAFUSO atrav\xE9s da mesa de teleporte!!"
    highlightTarget: {fileID: 570395347}
    image: {fileID: 21300000, guid: 5783679b17960914d9e898ed97d952c8, type: 3}
  - stepType: 4
    instruction: Pega ai.
    highlightTarget: {fileID: 357053973}
    image: {fileID: 21300000, guid: 88926e71fa79239489e9bfb7a2d36af3, type: 3}
  - stepType: 1
    instruction: Mandei!! Agora utiliza sua MESA DE REPARO para criar a bateria.
    highlightTarget: {fileID: 5861285230547151701}
    image: {fileID: 21300000, guid: 88926e71fa79239489e9bfb7a2d36af3, type: 3}
  - stepType: 5
    instruction: Manda ela de volta!
    highlightTarget: {fileID: 357053973}
    image: {fileID: 21300000, guid: 88926e71fa79239489e9bfb7a2d36af3, type: 3}
  - stepType: 4
    instruction: "T\xE1 na m\xE3o, parceiro."
    highlightTarget: {fileID: 570395347}
    image: {fileID: 21300000, guid: 5783679b17960914d9e898ed97d952c8, type: 3}
  - stepType: 2
    instruction: "Carrega a bateria nos seus CARREGADORES, mas cuidado para ela n\xE3o
      estourar!!"
    highlightTarget: {fileID: 5614764894695864592}
    image: {fileID: 21300000, guid: 5783679b17960914d9e898ed97d952c8, type: 3}
  - stepType: 4
    instruction: "Coloca a bateria na mesa, n\xE3o deixa cair hein!"
    highlightTarget: {fileID: 1984358413}
    image: {fileID: 21300000, guid: 5783679b17960914d9e898ed97d952c8, type: 3}
  - stepType: 6
    instruction: "Pegue a bandeja magn\xE9tica."
    highlightTarget: {fileID: 1141527350307869024}
    image: {fileID: 21300000, guid: 5783679b17960914d9e898ed97d952c8, type: 3}
  - stepType: 4
    instruction: Coloque a bateria nela.
    highlightTarget: {fileID: 1141527350307869024}
    image: {fileID: 21300000, guid: 5783679b17960914d9e898ed97d952c8, type: 3}
  - stepType: 4
    instruction: "Manda o PNEU tamb\xE9m"
    highlightTarget: {fileID: 2063029758}
    image: {fileID: 21300000, guid: 88926e71fa79239489e9bfb7a2d36af3, type: 3}
  - stepType: 3
    instruction: Entregando o pedido na BANCADA DE ENTREGA e...
    highlightTarget: {fileID: 4314568464621229337}
    image: {fileID: 21300000, guid: 88926e71fa79239489e9bfb7a2d36af3, type: 3}
  tutorialTextPlayer1: {fileID: 1596934282}
  tutorialImage: {fileID: 1513852119}
